# ListenerLoop configuration. Copy to .env and edit.
# Docker Compose reads this file; for local development `npm run dev` does too.

# COMPOSE_PROFILES and COMPOSE_FILE (how the app is exposed) are written by scripts/install.sh.
# ---- Required -------------------------------------------------------------
# Public address of this app. The widget, admin and embed script are served from here.
APP_URL=https://dash.example.com
# Domain only (no https://); used by Caddy for HTTPS in docker-compose.
APP_DOMAIN=dash.example.com
# Signs and protects sessions and stored secrets. Make one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-at-least-32-random-characters

# Cloudflare Turnstile. Create ONE widget in the Cloudflare dashboard and list your app's
# hostname (for example listenerloop.app) under its hostnames. Sites that embed ListenerLoop
# need no Turnstile key of their own. For local testing, Cloudflare's dummy keys always pass:
#   site 1x00000000000000000000AA   secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Storage --------------------------------------------------------------
# "s3" (any S3-compatible bucket: Cloudflare R2, Backblaze B2, MinIO, AWS) or "local" (a folder).
STORAGE_DRIVER=s3
# Local driver: audio is kept under this folder (inside the Docker volume by default).
# LOCAL_STORAGE_PATH=/data/audio
# S3 driver. For Cloudflare R2 the endpoint is https://<account-id>.r2.cloudflarestorage.com
# and the region is "auto". Keep the bucket private.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true   # needed by some self-hosted services such as MinIO

# ---- Email alerts ---------------------------------------------------------
# "smtp", "resend" or "none". Sent to each show's notification address (or the admin email).
MAIL_PROVIDER=smtp
MAIL_FROM="ListenerLoop <alerts@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Resend instead: MAIL_PROVIDER=resend and set the key below.
RESEND_API_KEY=

# ---- Optional tuning (defaults shown) ------------------------------------
# MAX_SECONDS_DEFAULT=180       # default message length for new shows
# MAX_UPLOAD_MB=15
# MP3_BITRATE_KBPS=64
# RETENTION_DAYS=0              # delete messages older than this many days (0 = keep forever; starred messages are kept)
# KEEP_ORIGINALS=false          # keep the uploaded original next to the MP3
# RATE_LIMIT_PER_HOUR=5         # submissions per IP per hour
# RATE_LIMIT_PER_SHOW_HOUR=60   # submissions per show per hour, from everyone
# DAILY_CAP_PER_SHOW=300        # submissions per show per 24 hours, from everyone
# TRUST_PROXY=true              # set false only if the app is exposed directly, with no proxy in front
# LOG_LEVEL=info
# PORT=3000
# DATABASE_PATH=/data/app.db
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Transcription (optional). Runs whisper.cpp on this server; audio never leaves it.
# Turn it on here, then tick "Transcribe new messages" on each show. The model is downloaded once
# into the data volume the first time it is needed.
# TRANSCRIPTION=off
# WHISPER_MODEL=small.en     # tiny.en, base.en, small.en (English only) or tiny, base, small (any language)
# WHISPER_THREADS=2          # CPU cores to use
# WHISPER_LANGUAGE=en        # defaults to en for .en models, otherwise auto-detect
# TRANSCRIBE_TIMEOUT_SEC=1800
